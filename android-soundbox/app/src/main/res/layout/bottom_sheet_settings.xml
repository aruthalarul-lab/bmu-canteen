<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Drag Pill -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#CBD5E1"
            android:layout_marginBottom="16dp" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ SoundBox Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/btnCloseSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:padding="6dp" />
        </LinearLayout>

        <!-- 1. TAMIL FEMALE VOICE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#93C5FD"
            app:cardBackgroundColor="#EFF6FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tamil Female Voice (பெண் குரல்)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1E3A8A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Optimized for crystal clear Tamil numbers"
                            android:textSize="11sp"
                            android:textColor="#3B82F6" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSheetPreviewVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="🔊 Hear Sample"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:cornerRadius="10dp"
                        android:backgroundTint="#2563EB" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/rgSheetFemaleVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbSheetFemaleNatural"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👩 Natural Female (தெளிவான தமிழ் பெண் குரல்)"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#1E293B" />

                    <RadioButton
                        android:id="@+id/rbSheetFemaleCrisp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📢 Crisp &amp; Loud (உரத்த பெண் குரல் - Best for Canteen)"
                        android:textSize="12sp"
                        android:textColor="#1E293B" />

                    <RadioButton
                        android:id="@+id/rbSheetFemaleSoft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌸 Soft &amp; Calm (மென்மையான பெண் குரல்)"
                        android:textSize="12sp"
                        android:textColor="#1E293B" />

                    <RadioButton
                        android:id="@+id/rbSheetVoiceDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Phone Default Voice (போன் இயல்பு குரல்)"
                        android:textSize="12sp"
                        android:textColor="#1E293B" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. LANGUAGE SELECTION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Announcement Language"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <RadioGroup
                    android:id="@+id/rgSheetLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbSheetEnglishTamil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌟 English + Tamil (Dual Language 🇬🇧+🇮🇳)"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSheetTamil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tamil Only (தமிழ் - 100 ரூபாய் பெறப்பட்டது)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSheetEnglish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English Only (Received ₹100 on Google Pay)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSheetHindi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hindi (Google Pay par 100 rupaye praapt hue)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSheetHinglish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hinglish (Google Pay par 100 rupaye received)"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSheetTelugu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telugu (Google Pay lo 100 roopaayilu vachhaayi)"
                        android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. VOICE AUDIO OPTIONS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊 Voice Options"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Repeat Announcement Twice"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetIncludePayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Announce Customer/Payer Name"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetVolumeBoost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Canteen Volume Boost (Max Sound)"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. HANDS-FREE REPEAT & GESTURES -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖐️ Hands-Free &amp; Floating LCD"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetVoiceCommand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎙️ Voice: 'Hey Raj, Repeat'"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetWaveRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👋 Wave Hand Over Screen to Repeat"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetFloatingLcd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📺 Floating LCD on Mobile Home Screen"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. MONITORED PAYMENT APPS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Monitored Payment Apps"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetAppGpay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Google Pay (GPay)"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetAppPhonepe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PhonePe"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetAppPaytm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paytm"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetAppBhim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BHIM UPI"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSheetAppBankSms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bank SMS Credit Alerts"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
