<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPI SoundBox"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice Payment Alerts • English &amp; Tamil • BMU Canteen"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- Digital Soundbox LCD Display Screen Window -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLcdDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#334155"
                app:cardBackgroundColor="#0F172A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- LCD Top Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● "
                            android:textColor="#34D399"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SOUNDBOX DIGITAL LCD DISPLAY"
                            android:textColor="#A7F3D0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvMainLcdLiveTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE LCD"
                            android:textColor="#34D399"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- LCD Screen Frame -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/lcd_screen_bg"
                        android:padding="14dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvMainLcdStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY • WAITING FOR PAYMENT"
                            android:textColor="#059669"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.1" />

                        <!-- Big Digital LCD Amount -->
                        <TextView
                            android:id="@+id/tvMainLcdAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹ 0.00"
                            android:textColor="#10B981"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp" />

                        <!-- Payer & App Detail -->
                        <TextView
                            android:id="@+id/tvMainLcdPayerApp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BMU Canteen • Smart Food Court"
                            android:textColor="#6EE7B7"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Bottom ticker inside bezel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvMainLcdTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Last payment: None yet"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/btnMainLcdPopOut"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📺 Pop-up on Mobile Home Page"
                            android:textColor="#F59E0B"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status & Master Switch Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_inactive"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_main" />

                            <TextView
                                android:id="@+id/tvStatusDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/desc_inactive"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchMasterSoundbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPermission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/grant_permission"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp"
                        android:backgroundTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row (Test Voice + Repeat Last Payment) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestVoice"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🔊 Test Alert"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp"
                    android:backgroundTint="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRepeatLast"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="🔁 Repeat Last"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp"
                    android:textColor="@color/primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <!-- Hands-Free Voice & Gesture Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CBD5E1"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖐️ Hands-Free Repeat (Without Touching Phone)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <!-- Voice Command Switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVoiceCommand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🎙️ Voice Command: 'Hey Raj, Repeat'"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Say 'Hey Raj, Repeat' or 'Repeat' anytime to hear the last payment out loud."
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="8dp" />

                    <!-- Proximity Wave Switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWaveRepeat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👋 Wave Hand Over Screen to Repeat"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Simply wave your hand across the top sensor to repeat without touching the screen."
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginStart="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Floating LCD Switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFloatingLcd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📺 Floating LCD Pop-up on Mobile Home Page"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shows a sleek floating digital LCD window on your phone home screen whenever money is received."
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginStart="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Voice & Language Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_settings"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <!-- Language Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_language"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="10dp" />

                    <RadioGroup
                        android:id="@+id/rgLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/rbEnglishTamil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌟 English + Tamil (Dual Language 🇬🇧+🇮🇳)"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbTamil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tamil Only (தமிழ் - 100 ரூபாய் பெறப்பட்டது)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbEnglish"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English Only (Received ₹100 on Google Pay)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbHindi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hindi (Google Pay par 100 rupaye praapt hue)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbHinglish"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hinglish (Google Pay par 100 rupaye received)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbTelugu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Telugu (Google Pay lo 100 roopaayilu vachhaayi)"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Switches -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchRepeat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repeat_announcement"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchIncludePayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/include_payer"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVolumeBoost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_boost"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Apps Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Enabled Payment Apps"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose which payment apps to listen and announce:"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAppGpay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Google Pay (GPay)"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAppPhonepe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PhonePe"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAppPaytm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Paytm"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAppBhim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BHIM UPI"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAppBankSms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bank SMS Credit Alerts"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- History Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recent_payments"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <TextView
                    android:id="@+id/btnSyncSms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥 Sync Yesterday's SMS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:padding="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_payments_yet"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPayments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Battery Tip -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/battery_tip"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:gravity="center" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
